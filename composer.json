{
    "name": "roundly-consulting/alerts-for-laravel",
    "description": "Schedule recurring health checks against any notifiable model, send throttled alert notifications when they fail and dispatch events when they fail, escalate or recover.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "alerts",
        "health-checks",
        "monitoring",
        "notifications"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/alerts-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/alerts-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Alerts\\": "src/",
            "RoundlyConsulting\\Alerts\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Alerts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Alerts\\AlertsServiceProvider"
            ],
            "aliases": {
                "Health": "RoundlyConsulting\\Alerts\\Facades\\Health"
            }
        }
    }
}
