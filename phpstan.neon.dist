includes:
    - vendor/larastan/larastan/extension.neon
    # The toolkit's Blueprint macro stubs (morphKey / ownerKey / polymorphicSubject) so
    # the key-type-aware migration columns resolve at level 7.
    - vendor/roundly-consulting/package-toolkit-for-laravel/extension.neon

parameters:
    level: 7
    paths:
        - src
        - database
        - config
        - tests/Models/Team.php
        - tests/Models/User.php
    configDirectories:
        - config
